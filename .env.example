# ===== 基础（沿用 v1）=====
RELATION_PROVIDER=llm
DATA_PATH=data/prod_df.csv
RUNS_DIR=runs
PAIR_LIMIT=200
RANDOM_SEED=42
REQUEST_TIMEOUT=90
MAX_RETRIES=3

# ===== 候选召回（Phase 1）=====
CANDIDATES_PER_PRODUCT=30
SIMILARITY_TOP_K=10
FUNCTIONAL_TOP_K=10
STYLE_TOP_K=10
DB_PATH=data/relations.db
INDEX_DIR=data/index

# ===== Embedding（OpenAI 兼容 / 百炼）=====
# EMBEDDING_API_KEY 与 LLM_API_KEY 通常是同一个 key
EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=
# text-embedding-v4（默认 1024 维）/ text-embedding-v3 / qwen3.7-text-embedding-flash
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_REVISION=
# 同步调用每请求文本数，须 ≤ 模型最大行数（text-embedding-v4=10、qwen3.7=20）
EMBEDDING_BATCH_SIZE=10
# 文本量达到该阈值改用 Batch 文件接口（约实时 50% 费用）；首次可先设 0 走同步跑通再开
EMBEDDING_BATCH_MIN=64
EMBEDDING_BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH_COMPLETION_WINDOW=24h
# 仅本地哈希 demo embedding 的维度（配了真实 EMBEDDING_MODEL 后忽略）
EMBEDDING_DIM=256

# ===== 初筛（Jev Noul，Phase 2）=====
SCREEN_PROVIDER=jev
# 关系成立概率阈值（未校准试验值，上线前先用阈值预览标定）
SCREEN_THRESHOLD=0.5
# 低分抽查比例（0..1，固定种子可复现）
SCREEN_AUDIT_RATE=0.02
SCREEN_CONCURRENCY=4
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest

# ===== 精判（LLM OpenAI 兼容，Phase 2）=====
DETAIL_PROVIDER=llm
DETAIL_CONCURRENCY=4
LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_API_KEY=
# 建议用较强的 qwen-max / qwen3-max，退而求其次 qwen-plus
LLM_MODEL=qwen-plus
# json_object 或 none（端点不支持 response_format 时用 none）
LLM_RESPONSE_FORMAT=json_object